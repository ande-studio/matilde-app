{
  "name": "matilde-app",
  "version": "0.1.0",
  "private": true,
  "description": "PWA de apoyo a la consejería para profesionales de postas médicas (Etapa 0)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "content": "tsx tools/build-content.ts",
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build && tsx tools/check-build.ts",
    "preview": "vite preview",
    "typecheck": "npm run content && tsc --noEmit",
    "test": "npm run content && vitest run --passWithNoTests",
    "icons": "tsx tools/make-icons.ts",
    "check:build": "tsx tools/check-build.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  }
}
